
/* User Code */
import java_cup.runtime.*; // defines the Symbol class
import java.util.LinkedList;

// The generated scanner will return a Symbol for each token that it finds.
// A Symbol contains an Object field named value; that field will be of type
// TokenVal, defined below.
//
// A TokenVal object contains the line number on which the token occurs as
// well as the number of the character on that line that starts the token.
// Some tokens (e.g., literals) also include the value of the token.

class TokenVal {
 // fields
    int linenum;
    int charnum;
 // constructor
    TokenVal(int l, int c) {
        linenum = l;
				charnum = c;
    }
}

class IntLitTokenVal extends TokenVal {
 // new field: the value of the integer literal
    int intVal;
 // constructor
    IntLitTokenVal(int l, int c, int val) {
        super(l,c);
				intVal = val;
    }
}


// The following class is used to keep track of the character number at which
// the current token starts on its line.
class CharNum {
  static int num=1;
}
/* Options and declarations */
%%
%state COMMENT
%state SINGLELINE_COMMENT
%state STRING 
%state YYINITIAL

DIGIT=		[0-9]
WHITESPACE=	[\ \t\n]
space= [\t\r\f\n\ ]
SEMICOLON = ";"
IDENTIFIER = [a-zA-Z_][a-zA-Z0-9_]*
INTNUMBER = [-|+]?(0|[1-9][0-9]*)

// The next 3 lines are included so that we can use the generated scanner
// with java CUP (the Java parser generator)
%implements java_cup.runtime.Scanner
%function next_token
%type java_cup.runtime.Symbol

// Tell JLex what to do on end-of-file
%eofval{
						return new Symbol(sym.EOF); 
%eofval}

%{
		//it's a stack - each new string gets pushed on top
    LinkedList<StringBuilder> stringBuffers = new LinkedList<StringBuilder>();
%}


// Turn on line counting
%line

/*Lexical Rules*/
%%

/* Rules for STRING state */
<YYINITIAL>"\"" {
    System.out.println("Start of a parsing string literal..");
		stringBuffers.add(new StringBuilder()); 
    yybegin(STRING); // Switch to STRING state
}

<STRING>"\"" {
		System.out.println("Parsed String Literal: " + stringBuffers.get(stringBuffers.size() - 1).toString());
    System.out.println("End of parsing string literal..");
    yybegin(YYINITIAL); // Return to the initial state
    Symbol S = new Symbol(sym.STRINGLITERAL, new TokenVal(yyline+1, CharNum.num));
    CharNum.num += yytext().length();
    return S;
}

<STRING>[^\"\n\r]+ {
		stringBuffers.get(stringBuffers.size() - 1).append(yytext());
    CharNum.num += yytext().length(); // Consme any other characters inside strings
}

<STRING>\\n {
    System.out.println("Unterminated string literal");
		switch(yytext().charAt(0)) {
			case '\n':
				stringBuffers.get(stringBuffers.size() - 1).append('\n');
				CharNum.num += 2; // Reset character number at the start of a new line
				break;
			case '\r':
				stringBuffers.get(stringBuffers.size() - 1).append('\r');
				CharNum.num += 2; // Reset character number at the start of a new line
				break;
			default: 
				// no reach
				break;
		}
		
    yybegin(YYINITIAL); // Return to the initial state
}
<STRING><<EOF>> {
		System.out.println("Unterminated string literal at EOF");
		System.out.println("Read until EOF: " + stringBuffers.get(stringBuffers.size() - 1).toString());
		Errors.fatal(yyline+1, CharNum.num,
					"Unterminated string literal at EOF");
		yybegin(YYINITIAL); // Return to the initial state
}


/* Rules for YYINITIAL state */
{SEMICOLON} {
										System.out.println("Found a semicolon");
										Symbol S = new Symbol(sym.SEMICOLON, new TokenVal(yyline+1, CharNum.num));
										CharNum.num += yytext().length();
										return S;
	   }



"+"	 {
					Symbol S = new Symbol(sym.PLUS, new TokenVal(yyline+1, CharNum.num));
	    		CharNum.num++;
	    		return S;
	   }

"-" {
					Symbol S = new Symbol(sym.MINUS, new TokenVal(yyline+1, CharNum.num));
	    		CharNum.num++;
	    		return S;
	   }

"System.out.println" {
										System.out.println("Found a println");
										Symbol S = new Symbol(sym.SYSTEMOUTPRINTLN, new TokenVal(yyline+1, CharNum.num));
										CharNum.num += yytext().length();
										return S;
	   }
"int" {
										System.out.println("Found an int");
										Symbol S = new Symbol(sym.INT, new TokenVal(yyline+1, CharNum.num)); //int type is actually long
										CharNum.num += yytext().length();
										return S;
	   }


"do" {
										System.out.println("Found a do");
										Symbol S = new Symbol(sym.DO, new TokenVal(yyline+1, CharNum.num));
										CharNum.num += yytext().length();
										return S;
	   }
"case" {
										System.out.println("Found a case");
										Symbol S = new Symbol(sym.CASE, new TokenVal(yyline+1, CharNum.num));
										CharNum.num += yytext().length();
										return S;
	   }
"default" {
										System.out.println("Found a default");
										Symbol S = new Symbol(sym.DEFAULT, new TokenVal(yyline+1, CharNum.num));
										CharNum.num += yytext().length();
										return S;
	   }
"&&" {
										System.out.println("Found a &&");
										Symbol S = new Symbol(sym.AND, new TokenVal(yyline+1, CharNum.num));
										CharNum.num += yytext().length();
										return S;
	   }
"switch" {
										System.out.println("Found a switch");
										Symbol S = new Symbol(sym.SWITCH, new TokenVal(yyline+1, CharNum.num));
										CharNum.num += yytext().length();
										return S;
	   }

"and" {
										System.out.println("Found an and");
										Symbol S = new Symbol(sym.AND, new TokenVal(yyline+1, CharNum.num));
										CharNum.num += yytext().length();
										return S;
	   }
"=" {
										System.out.println("Found an assignment operator");
										Symbol S = new Symbol(sym.ASSIGN, new TokenVal(yyline+1, CharNum.num));
										CharNum.num += yytext().length();
										return S;
}


{WHITESPACE}+  {CharNum.num += yytext().length();}

{INTNUMBER} {// NOTE: the following computation of the integer value does NOT
	    //       check for overflow.  This must be changed.
			System.out.println("Found an integer literal: " + yytext());	
	    long val = Long.parseLong(yytext());
	    Symbol S = new Symbol(sym.INTLITERAL, new IntLitTokenVal(yyline+1, CharNum.num, (int) val));
	    CharNum.num += yytext().length();
	    return S;
	   }



<YYINITIAL>{IDENTIFIER} {
										System.out.println("Found identifier named: " + yytext());
										Symbol S = new Symbol(sym.IDENTIFIER, new TokenVal(yyline+1, CharNum.num)); //Symbol is not the right type
										CharNum.num += yytext().length();
										return S;

}


/* Rules for COMMENT state (Block Comment) */
<YYINITIAL>"/*" {
			yybegin(COMMENT);
}
<COMMENT>{WHITESPACE}+  {
	CharNum.num += yytext().length();
	}


<COMMENT>"*/" {
			yybegin(YYINITIAL);
}

<COMMENT>. {
    CharNum.num += yytext().length(); // Consume any other characters inside comments
}
<COMMENT><<EOF>> {
		Errors.fatal(yyline+1, CharNum.num,
					"Unterminated comment at EOF");
		yybegin(YYINITIAL); // Return to the initial state
}   

/* Rules for SINGLELINE_COMMENT state (single line comment) */
<YYINITIAL>"//" {
			yybegin(SINGLELINE_COMMENT);
}

<SINGLELINE_COMMENT>.|[\n|\r] {
		if (yytext().equals("\n")) {
				yybegin(YYINITIAL);
				CharNum.num++; // Move to the next line
		} else {
				CharNum.num += yytext().length(); // Consume characters in single-line comment
		}
}
<SINGLELINE_COMMENT><<EOF>> {
		yybegin(YYINITIAL); // Return to the initial state
}
	    
.	{
					Errors.fatal(yyline+1, CharNum.num,
					"ignoring illegal character: " + yytext());
					CharNum.num++;
	   }
