public class MultiMethodTest {
    static int x;
    
    public static void main() {
        int a;
        int b;
        a = 5;
        b = 3;
        x = a + b;
        System.out.println(x);
    }
    
    public static void helper() {
        int temp;
        temp = 42;
        x = temp;
    }
}