public class SimpleIfTest {
    static int x;
    
    public static void main() {
        int a;
        int b;
        
        a = 5;
        b = 10;
        
        // Test if-else
        if (a < b) {
            x = a + b;
        } else {
            x = a - b;
        }
        
        println(x);
    }
}