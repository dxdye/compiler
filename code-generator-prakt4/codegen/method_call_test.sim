public class MethodCallTest {
    static int globalResult;

    public static int add(int a, int b) {
        int result;
        result = a + b;
        return result;
    }

    public static void setGlobal(int value) {
        globalResult = value;
    }

    public static void main() {
        int x;
        int y;
        int sum;

        x = 10;
        y = 20;
        
        sum = add(x, y);
        setGlobal(sum);
        
        println(globalResult);
    }
}